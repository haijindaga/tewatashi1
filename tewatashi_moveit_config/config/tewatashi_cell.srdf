<?xml version="1.0" encoding="UTF-8"?>
<!--
  Semantic description of the cell. Written by hand following
  my_robot_cell.srdf (official UR tutorial) and ur_macro.srdf.xacro
  (ur_moveit_config, ur_robot_driver 2.13.0).

  Collision matrix: only the UR arm pairs from ur_moveit_config plus pairs
  that are rigidly attached or always touching. Everything else stays
  enabled (conservative). After the real geometry is known, regenerate it
  with the MoveIt Setup Assistant:
    ros2 launch tewatashi_moveit_config setup_assistant.launch.py
-->
<robot name="tewatashi_cell">
    <group name="ur_arm">
        <chain base_link="base_link" tip_link="tool0"/>
    </group>

    <!-- "up" pose of ur_moveit_config = initial pose of the mock hardware.
         Arm straight up, clear of the table. -->
    <group_state name="home" group="ur_arm">
        <joint name="shoulder_pan_joint" value="0"/>
        <joint name="shoulder_lift_joint" value="-1.5707"/>
        <joint name="elbow_joint" value="0"/>
        <joint name="wrist_1_joint" value="-1.5707"/>
        <joint name="wrist_2_joint" value="0"/>
        <joint name="wrist_3_joint" value="0"/>
    </group_state>

    <!-- UR arm (from ur_moveit_config) -->
    <disable_collisions link1="base_link" link2="base_link_inertia" reason="Adjacent"/>
    <disable_collisions link1="base_link_inertia" link2="shoulder_link" reason="Adjacent"/>
    <disable_collisions link1="tool0" link2="wrist_1_link" reason="Never"/>
    <disable_collisions link1="tool0" link2="wrist_2_link" reason="Never"/>
    <disable_collisions link1="tool0" link2="wrist_3_link" reason="Adjacent"/>
    <disable_collisions link1="forearm_link" link2="upper_arm_link" reason="Adjacent"/>
    <disable_collisions link1="forearm_link" link2="wrist_1_link" reason="Adjacent"/>
    <disable_collisions link1="shoulder_link" link2="upper_arm_link" reason="Adjacent"/>
    <disable_collisions link1="wrist_1_link" link2="wrist_2_link" reason="Adjacent"/>
    <disable_collisions link1="wrist_1_link" link2="wrist_3_link" reason="Never"/>
    <disable_collisions link1="wrist_2_link" link2="wrist_3_link" reason="Adjacent"/>

    <!-- Robot base on the table (as in the official tutorial) -->
    <disable_collisions link1="table" link2="base_link_inertia" reason="Adjacent"/>
    <disable_collisions link1="table" link2="shoulder_link" reason="Never"/>

    <!-- Gripper and camera are rigidly attached to the flange -->
    <disable_collisions link1="wrist_3_link" link2="gripper_body" reason="Adjacent"/>
    <disable_collisions link1="wrist_3_link" link2="camera_link" reason="Adjacent"/>
    <disable_collisions link1="gripper_body" link2="camera_link" reason="Adjacent"/>
</robot>
